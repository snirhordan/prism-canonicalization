{
    "gpu": {
        "use": true,
        "id": 0
    },
    "model": "PNA",
    "dataset": "OGBG-MOLTOX21",
    "out_dir": "out/PNA_MOLTOX21_PRiSM/",
    "params": {
        "seed": 41,
        "epochs": 1000,
        "batch_size": 256,
        "init_lr": 0.0005,
        "lr_reduce_factor": 0.8,
        "lr_schedule_patience": 10,
        "min_lr": 8e-05,
        "weight_decay": 3e-06,
        "max_time": 96
    },
    "net_params": {
        "L": 8,
        "hidden_dim": 115,
        "out_dim": 113,
        "residual": true,
        "edge_feat": true,
        "readout": "sum",
        "dropout": 0.4,
        "dropout_2": 0.1,
        "graph_norm": true,
        "batch_norm": true,
        "aggregators": "mean max min std",
        "scalers": "identity amplification attenuation",
        "edge_dim": 50,
        "pretrans_layers": 1,
        "posttrans_layers": 1,
        "pe_init": "prism",
        "prism_preset": "moltox21_pna",
        "pos_enc_dim": 16,
        "sign_inv_net": "masked_gin",
        "sign_inv_layers": 7,
        "phi_out_dim": 115,
        "sign_inv_activation": "relu"
    }
}
