{
    "gpu": {
        "use": true,
        "id": 0
    },
    "model": "PNA",
    "dataset": "OGBG-MOLPCBA",
    "out_dir": "out/PNA_MOLPCBA_PRiSM/",
    "params": {
        "seed": 41,
        "epochs": 300,
        "batch_size": 512,
        "init_lr": 0.0005,
        "lr_reduce_factor": 0.8,
        "lr_schedule_patience": 10,
        "min_lr": 2e-05,
        "weight_decay": 3e-06,
        "max_time": 120
    },
    "net_params": {
        "L": 4,
        "hidden_dim": 304,
        "out_dim": 304,
        "residual": true,
        "edge_feat": true,
        "readout": "sum",
        "dropout": 0.2,
        "dropout_2": 0.0,
        "graph_norm": true,
        "batch_norm": true,
        "aggregators": "mean sum max",
        "scalers": "identity",
        "edge_dim": 16,
        "pretrans_layers": 1,
        "posttrans_layers": 1,
        "pe_init": "prism",
        "prism_preset": "molpcba_pna",
        "pos_enc_dim": 16,
        "sign_inv_net": "masked_gin",
        "sign_inv_layers": 8,
        "phi_out_dim": 304,
        "sign_inv_activation": "relu"
    }
}
