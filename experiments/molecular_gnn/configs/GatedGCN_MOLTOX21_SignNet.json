{
    "gpu": {
        "use": true,
        "id": 0
    },
    "model": "GatedGCN",
    "dataset": "OGBG-MOLTOX21",
    "out_dir": "out/GatedGCN_MOLTOX21_SignNet/",
    "params": {
        "seed": 41,
        "epochs": 1000,
        "batch_size": 32,
        "init_lr": 0.001,
        "lr_reduce_factor": 0.14,
        "lr_schedule_patience": 22,
        "min_lr": 1e-05,
        "weight_decay": 5e-06,
        "max_time": 48
    },
    "net_params": {
        "L": 8,
        "hidden_dim": 150,
        "out_dim": 150,
        "residual": true,
        "readout": "mean",
        "dropout": 0.4,
        "batch_norm": true,
        "pe_init": "signnet",
        "pos_enc_dim": 3,
        "sign_inv_net": "masked_gin",
        "sign_inv_layers": 6,
        "phi_out_dim": 150,
        "sign_inv_activation": "relu"
    }
}
